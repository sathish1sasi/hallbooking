# Copy to .env.local and fill in from Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Supabase -> Project Settings -> API -> service_role key. Needed for the daily job.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=
# Email reminders via https://resend.com (verify your domain there first)
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Your Firm <reminders@yourfirm.in>"
# Optional: WhatsApp Cloud API (Meta). Template must have two body variables: {{1}} name, {{2}} details.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=client_reminder
WHATSAPP_TEMPLATE_LANG=en
